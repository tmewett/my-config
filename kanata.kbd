(deflayermap (default)
  f13 (tap-hold-order 0 0 esc (layer-while-held nav)))

(deflayermap (nav)
  e    bck
  r    fwd
  y    C-del
  u    C-left
  i    C-bspc
  o    C-rght
  p    del
  esc  lrld
  d    ctl
  f    shft
  h    left
  j    down
  k    up
  l    rght
  ;    bspc
  apos (macro down ret)
  n    home
  m    pgdn
  ,    pgup
  .    end)
